      "versionNonce": 2072201235,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788341113468,
      "link": null,
      "locked": false,
      "text": "Uber / Ride Sharing application\n\nFlow - \n1. User comes to application\n2. User will submit a request for booking a ride and and estimated fare is shown\n3. Drivers in the nearby area gets request for accepting the ride\n4. Driver accept the ride\n5. Driver goes to start location of ride, otp is asked\n6. Ride starts\n7. Ride ends\n8. FareCalculation is done\n9. User can share experience and reviews\n\nEntities - \nUser/Rider\nDriver\nRide\nVehicle\nLocation\nPayment\n\n//\nUserManager\nOtpService\nFareCalculationService\n\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uber / Ride Sharing application\n\nFlow - \n1. User comes to application\n2. User will submit a request for booking a ride and and estimated fare is shown\n3. Drivers in the nearby area gets request for accepting the ride\n4. Driver accept the ride\n5. Driver goes to start location of ride, otp is asked\n6. Ride starts\n7. Ride ends\n8. FareCalculation is done\n9. User can share experience and reviews\n\nEntities - \nUser/Rider\nDriver\nRide\nVehicle\nLocation\nPayment\n\n//\nUserManager\nOtpService\nFareCalculationService\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
