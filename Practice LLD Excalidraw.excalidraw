      "type": "text",
      "x": 1999.3144932166952,
      "y": 13865.79047051859,
      "width": 1583.999267578125,
      "height": 1215,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fefeff",
